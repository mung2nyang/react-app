{
  "name": "react-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "typecheck:strict-inventory": "tsc -p tsconfig.strict-inventory.json --noEmit",
    "test": "npm run test:unit && npm run test:app",
    "test:unit": "node --experimental-test-module-mocks --test-force-exit --test-timeout=60000 --test \"src/domain/**/*.test.js\" \"src/lib/**/*.test.js\" \"src/store/**/*.test.js\"",
    "test:app": "node --experimental-test-module-mocks --test-force-exit --test-timeout=60000 --test \"src/app/**/*.test.js\" \"src/components/**/*.test.js\""
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "oxlint": "^1.75.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  }
}

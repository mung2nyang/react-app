{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "oxc"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": "off"
  },
  "overrides": [
    {
      "files": ["**/*.test.js", "**/*.test.ts", "**/*.test.tsx"],
      "rules": {
        "react/immutability": "off",
        "react/globals": "off"
      }
    }
  ]
}
